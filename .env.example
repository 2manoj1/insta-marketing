# ==========================================
# LLM Gateway Configuration
# ==========================================
# Default: Local OpenAI-compatible gateway for Ollama-backed model traffic
LLM_API_BASE=https://api.manojmukherjee.co.in/v1
# Or local Ollama:
# LLM_API_BASE=http://localhost:11434/v1

# API Key (use dummy if your gateway does not require authentication)
LLM_API_KEY=dummy-token

# Target Model Name (e.g., llama3.2, mistral, qwen2.5)
LLM_MODEL=llama3.2

# ==========================================
# Target Creator Configuration (Optional)
# ==========================================
# If left empty, the script/CLI will ask interactively after login
CREATOR_HANDLE=
CREATOR_URL=

# ==========================================
# Browser & Playwright Settings
# ==========================================
# Set to false to see the browser window for manual human login
HEADLESS=false
SESSION_FILE=instagram_session.json
LOGIN_DELAY_SECONDS=5

# ==========================================
# Outreach Mode
# ==========================================
# 'preview' (safely saves and displays drafts) or 'mock'
OUTREACH_MODE=preview
